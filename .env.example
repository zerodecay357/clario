# Supabase (Project Settings → API). Either the publishable or the legacy anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Postgres, Transaction pooler (port 6543). Used from Stage 1.
DATABASE_URL=
# openssl rand -base64 32  (encrypts Moodle tokens; Stage 1)
CLARIO_ENC_KEY=
# openssl rand -hex 32  (protects cron + health routes)
CRON_SECRET=
# LLM (Stage 2). LLM_PROVIDER=anthropic|gemini (optional)
LLM_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
GEMINI_API_KEY=
GEMINI_MODEL=
NEXT_PUBLIC_APP_URL=http://localhost:3000
